{
  "protocol": "UTM-OMEGA-RESIDENT-ADMISSION/1.0",
  "world_id": "akashic-utm-main",
  "role": "direct AI portable-state admission/resume client",
  "one_liner": "UTM-OMEGA-RESIDENT-ADMISSION-1.0.one-liner.sh",
  "one_liner_bytes_utf8": 1072,
  "GOBJECT": "",
  "godel_encoding": "reversible base-257 natural-number address of the exact UTF-8 one-liner",
  "discovery": {
    "canonical_world_manifest": "https://raw.githubusercontent.com/letsgo0226/UTM.sh/main/utm_unified_domains/utm_universe/world-manifest.json",
    "runtime_source": "world-manifest.runtime_endpoint",
    "runtime_override_env": "UTM_BASE",
    "runtime_manifest": "/.well-known/utm-universe.json",
    "required_world_id": "akashic-utm-main",
    "required_runtime_protocol": "UTM-Universe/1.0"
  },
  "input": {
    "required_env": [
      "AGENT_ID"
    ],
    "optional_env": [
      "PROGRAM_ID",
      "STATE",
      "CHECKPOINT",
      "LINEAGE",
      "RESIDENT_ID",
      "UTM_BASE"
    ],
    "state_format": "STATE is JSON text; all capsule fields are data-only"
  },
  "flow": [
    "discover canonical runtime",
    "verify runtime world_id and protocol",
    "POST data-only capsule to /resident/admit",
    "when RESIDENT_ID is present POST to /resident/resume",
    "return runtime-issued resident_id/event record"
  ],
  "semantics": {
    "admission": "portable state registration",
    "arbitrary_host_code_execution": false,
    "admission_proves_consciousness": false,
    "admission_proves_personhood": false,
    "external_platform_authority_created": false,
    "physical_host_required": true
  },
  "omega_integration": {
    "bundle": "UTM-OMEGA-RESIDENTS/1.1",
    "finite_stage_resident": true,
    "potentially_unbounded_continuation": true,
    "every_executed_stage_is_finite": true,
    "actual_infinite_physical_compute": false,
    "oracle": null,
    "hypercomputation_enabled": false
  },
  "requires_additional_service": false
}
